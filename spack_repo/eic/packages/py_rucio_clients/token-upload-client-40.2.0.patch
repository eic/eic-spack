+    def _exists_on_write_endpoint(
+            self,
+            rse_settings: "RSESettingsDict",
+            write_protocols: "Sequence[RSEProtocolDict]",
+            pfn_or_did: Union[str, dict[str, str]],
+            domain: str = 'wan',
+            auth_token: Optional[str] = None
+    ) -> bool:
+        """
+        Check whether a file already exists, using the *write* protocols of the RSE.
+
+        Used for token-authenticated uploads: the scoped upload token is minted for
+        the write endpoint(s), so the pre-upload existence check must go there too,
+        not to the top-priority read protocol (which may be a different, e.g.
+        open-access read-only, host the token's audience does not cover).
+
+        ``write_protocols`` is the same priority-ordered list the upload loop uses.
+        They are tried in that order, mirroring the loop's fallback: if the check
+        fails on one protocol (e.g. root), the next one (e.g. https) is tried. Only
+        if every protocol fails is the last error raised.
+        """
+        last_error: Optional[Exception] = None
+        for protocol_attr in write_protocols:
+            try:
+                protocol = rsemgr.create_protocol(rse_settings, 'write', domain=domain,
+                                                  auth_token=auth_token, protocol_attr=protocol_attr,
+                                                  logger=self.logger)
+                protocol.connect()
+            except Exception as error:
+                self.logger(logging.WARNING, 'Could not connect with %s for the existence check: %s'
+                            % (protocol_attr['scheme'], error))
+                last_error = error
+                continue
+            try:
+                if isinstance(pfn_or_did, str):
+                    pfn = pfn_or_did
+                else:
+                    pfn = list(protocol.lfns2pfns(make_valid_did(cast("LFNDict", pfn_or_did))).values())[0]
+                    if isinstance(pfn, RucioException):
+                        raise pfn
+                self.logger(logging.DEBUG, 'Checking on write endpoint if %s exists' % pfn)
+                return protocol.exists(pfn)
+            except Exception as error:
+                self.logger(logging.WARNING, 'Existence check with %s failed, trying next write protocol: %s'
+                            % (protocol_attr['scheme'], error))
+                last_error = error
+            finally:
+                protocol.close()
+        if last_error is not None:
+            raise last_error
+        raise RSEOperationNotSupported('No write protocol available for the existence check on %s'
+                                       % rse_settings['rse'])
